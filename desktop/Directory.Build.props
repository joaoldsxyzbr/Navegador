<Project>

  <!-- Importa o props da raiz: o MSBuild para no primeiro Directory.Build.props. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Nem todo projeto é um projeto de teste. O app Windows depende do pacote
    CefSharp/Chromium e de WinForms, então os testes rodam apenas sobre o Core.
  -->
  <PropertyGroup>
    <TestProject Condition="'$(TestProject)' == ''">false</TestProject>
  </PropertyGroup>

</Project>
