<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\rumo.ico</ApplicationIcon>
    <AssemblyName>Navegador</AssemblyName>
    <RootNamespace>Navegador.Windows</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- CefSharp/CEF precisa distribuir DLLs, subprocesso, locales e recursos ao lado do executável. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- A versão vem do arquivo VERSION, via Directory.Build.props. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.WinForms.NETCore" Version="152.0.100" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\rumo-mark.svg" LogicalName="Rumo.Mark.svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Navegador.Core\Navegador.Core.csproj" />
  </ItemGroup>

</Project>
